# --- Required ---
OPENAI_API_KEY=sk-your-key-here

# --- LLM configuration (optional) ---
OPENAI_MODEL=gpt-4o-mini          # answering model
EVAL_MODEL=gpt-4o-mini            # LLM-as-judge model
NUM_RESULTS=5                     # top-k retrieved sections

# --- Postgres (defaults work with docker-compose) ---
POSTGRES_HOST=postgres
POSTGRES_DB=zoning_assistant
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

# --- Ports ---
APP_PORT=5000
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# --- Misc ---
TZ=America/Los_Angeles
DATA_PATH=data/zoning.csv
PARCELS_PATH=data/parcels.csv
